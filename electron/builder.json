{
  "appId": "vn.fzink.app",
  "productName": "fzInK",
  "compression": "maximum",
  "npmRebuild": false,
  "afterPack": "electron/afterPack.cjs",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "!dist/web-update.zip",
    "!dist/desktop-app-bundle.html",
    "electron/main.cjs",
    "electron/preload.cjs",
    "electron/otaUpdater.cjs",
    "!node_modules/**/*"
  ],
  "extraMetadata": {
    "main": "electron/main.cjs"
  },
  "protocols": {
    "name": "fzInK",
    "schemes": ["fzink", "bttm"]
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "public/pwa-512x512.png",
    "legalTrademarks": "Bản quyền © 2026 fzInK. Toàn quyền bảo lưu."
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64", "x64"]
      },
      {
        "target": "zip",
        "arch": ["arm64", "x64"]
      }
    ],
    "category": "public.app-category.education",
    "icon": "public/pwa-512x512.png",
    "artifactName": "fzInK-macOS-${arch}.${ext}",
    "identity": null
  },
  "nsis": {
    "artifactName": "fzInK-Setup.${ext}",
    "oneClick": false,
    "perMachine": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "fzInK",
    "uninstallDisplayName": "fzInK",
    "license": "electron/license.txt",
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false
  },
  "portable": {
    "artifactName": "fzInK-Portable.${ext}"
  },
  "dmg": {
    "artifactName": "fzInK-macOS-${arch}.${ext}"
  }
}
